# PSK Intelligence — environment variables (example)
# Copy to .env and fill in real values. Never commit .env.

# --- App ---
# Port the dev server and E2E suite use (defaults to 8080)
# E2E_PORT=8080
# E2E_BASE_URL=http://localhost:8080

# --- Backend (optional — only needed if backend features are enabled) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

